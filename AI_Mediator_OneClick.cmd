@echo off
setlocal EnableExtensions
set "GW=C:\Users\krimo25\Downloads\token-free-gateway-main\token-free-gateway-main"
set "TMP=%TEMP%\AI_Mediator_GUI_Server.js"
if not exist "%GW%" (
  echo [ERROR] Gateway folder not found:
  echo %GW%
  pause
  exit /b 1
)
powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=''; [IO.File]::WriteAllBytes('%TMP%',[Convert]::FromBase64String($b))"
start "AI Gateway" /D "%GW%" cmd /k bun run start
echo Waiting for Gateway on 3456...
for /l %%i in (1,1,90) do (
  powershell -NoProfile -Command "try { Invoke-WebRequest -UseBasicParsing http://127.0.0.1:3456/v1/models -TimeoutSec 1 | Out-Null; exit 0 } catch { exit 1 }" >nul 2>&1
  if not errorlevel 1 goto ready
  timeout /t 1 /nobreak >nul
)
echo [ERROR] Gateway did not become ready on port 3456.
pause
exit /b 1
:ready
start "AI Mediator GUI" /D "%TEMP%" cmd /k node "%TMP%"
timeout /t 2 /nobreak >nul
start "" "http://127.0.0.1:3000/"
exit /b 0
